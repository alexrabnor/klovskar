PORT=3131
NODE_ENV=production
BAS_URL=https://adventdeckare.alexcloud.se
CORS_ORIGIN=https://adventdeckare.alexcloud.se

# /admin – lösenordet till adminsidan (appen vägrar starta utan det)
ADMIN_LOSEN=

# Simulerat datum för hela servern, t.ex. 2026-12-14T08:00 (svensk tid).
# Lämna tomt i skarp drift – då gäller verklig tid.
TESTLAGE_DATUM=

# Försäljning
PRIS_KR=99
STRIPE_LAGE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# Säljare (visas i sidfot, villkor och mejl)
SALJARE_NAMN=
SALJARE_EPOST=

# E-post via Brevo
BREVO_API_KEY=
MAIL_FROM=adventdeckare@alexcloud.se

# Web push (skapa med: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:adventdeckare@alexcloud.se
