PORT=3131
NODE_ENV=production
BAS_URL=https://adventdeckare.se
CORS_ORIGIN=https://adventdeckare.se

# /admin – lösenordet till adminsidan (appen vägrar starta utan det)
ADMIN_LOSEN=

# Simulerat datum för hela servern, t.ex. 2026-12-14T08:00 (svensk tid).
# Lämna tomt i skarp drift – då gäller verklig tid.
TESTLAGE_DATUM=

# Försäljning
PRIS_KR=99
STRIPE_LAGE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# Säljare (visas i sidfot, villkor och mejl)
SALJARE_NAMN=
SALJARE_EPOST=
SALJARE_ADRESS=

# E-post via Brevo
BREVO_API_KEY=
MAIL_FROM=hej@adventdeckare.se

# Web push (skapa med: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:adventdeckare@alexcloud.se

# Öppna köpet i Stripes testläge (bara för att prova köpkedjan). Utan den är köpet stängt tills STRIPE_LAGE=live.
TESTKOP=

# Barndeckaren (Stjärnan som försvann). BARN=1 slår på /barn, /barn/admin och köp av barndeckaren och paketet.
# STARTSIDA=barn gör dessutom /barn till startsida – används på barndeckare.alexcloud.se.
BARN=
STARTSIDA=
# Priser i kronor. Lämna tomt för 60 kr (barndeckaren) och 150 kr (båda spelen).
PRIS_BARN_KR=
PRIS_BADA_KR=
